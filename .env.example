# LLM Limits Overlay - Конфигурация API-ключей
# Ключи читаются из файла .env рядом с LlmLimitsOverlay.exe (приоритет)
# с fallback на переменные окружения процесса.
#
# Дополнительные ключи для вторых карточек провайдеров
# (см. раздел "Провайдеры в конфиге" в README):
# OPENROUTER_API_KEY_2=sk-or-v1-your-second-openrouter-key-here
# KIMI_API_KEY_2=sk-your-second-kimi-key-here

OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
KIMI_API_KEY=sk-your-kimi-key-here
