    <Compile Include="..\LlmLimitsOverlay\Models.cs" Link="Models.cs" />
    <Compile Include="..\LlmLimitsOverlay\SimpleJson.cs" Link="SimpleJson.cs" />
    <Compile Include="..\LlmLimitsOverlay\EnvParser.cs" Link="EnvParser.cs" />
    <Compile Include="..\LlmLimitsOverlay\Logger.cs" Link="Logger.cs" />
    <Compile Include="..\LlmLimitsOverlay\AgyResolver.cs" Link="AgyResolver.cs" />
    <Compile Include="..\LlmLimitsOverlay\Config.cs" Link="Config.cs" />
  </ItemGroup>

</Project>
